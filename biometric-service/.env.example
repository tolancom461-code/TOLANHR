# Independent biometric service only. Do NOT reuse/import the main application's .env file.
BIOMETRIC_HOST=0.0.0.0
BIOMETRIC_PORT=9095

# Fail-closed device allow-list. Logical identity = vendor + serial number.
BIOMETRIC_ALLOWED_DEVICES=zkteco:AJE1261900133

# Database is the production/default durability backend from v0.9 onward.
# The service never creates/alters/drops tables automatically.
BIOMETRIC_STORAGE_MODE=database
BIOMETRIC_DB_HOST=
BIOMETRIC_DB_PORT=4000
BIOMETRIC_DB_USER=
BIOMETRIC_DB_PASSWORD=
BIOMETRIC_DB_NAME=test
BIOMETRIC_DB_SSL_MODE=required
BIOMETRIC_DB_CONNECTION_LIMIT=5
BIOMETRIC_DB_REPLAY_LIMIT=1000
BIOMETRIC_DB_RETRY_DELAY_SECONDS=30

# File mode remains available only for isolated lab/backward-compatibility use.
# BIOMETRIC_STORAGE_MODE=file
BIOMETRIC_CAPTURE_DIR=./var/captures

BIOMETRIC_LOG_DIR=./var/logs
BIOMETRIC_LOG_TIMEZONE=Asia/Riyadh
BIOMETRIC_MAX_BODY_BYTES=524288

# observe = persist but do not acknowledge ATTLOG.
# ack = acknowledge only after sanitized durable ingest has committed.
BIOMETRIC_ATTLOG_ACK_MODE=observe

BIOMETRIC_ADMS_DELAY_SECONDS=10
BIOMETRIC_ADMS_ERROR_DELAY_SECONDS=60
BIOMETRIC_ADMS_REALTIME=1
BIOMETRIC_ADMS_ENCRYPT=0

# Periodic recovery sweep for canonical processing and durable automatic-Finalization intents.
BIOMETRIC_DB_RETRY_SWEEP_SECONDS=10

# Automatically finalize canonical punches created after startup replay.
# New punches carry a durable pending intent; transient Finalization failures retry after BIOMETRIC_DB_RETRY_DELAY_SECONDS.
# Existing historical punches are never swept/backfilled automatically.
BIOMETRIC_AUTO_FINALIZE_NEW_PUNCHES=true

# Diagnostic NDJSON rotation. service.ndjson is rotated before exceeding this size.
BIOMETRIC_LOG_MAX_BYTES=10485760
BIOMETRIC_LOG_RETAIN_FILES=5

# Standalone local administration UI (v0.12.0)
# Kept on loopback intentionally so the management UI is not exposed to the device LAN.
BIOMETRIC_ADMIN_ENABLED=true
BIOMETRIC_ADMIN_HOST=127.0.0.1
BIOMETRIC_ADMIN_PORT=9096

# Versioned read-only Final Events integration API (v0.13.0).
# Disabled by default and loopback-only in this release. It does not connect to the main app.
# When enabled, use an independent random bearer token of at least 32 characters.
BIOMETRIC_FINAL_EVENTS_API_ENABLED=false
BIOMETRIC_FINAL_EVENTS_API_HOST=127.0.0.1
BIOMETRIC_FINAL_EVENTS_API_PORT=9097
BIOMETRIC_FINAL_EVENTS_API_TOKEN=
