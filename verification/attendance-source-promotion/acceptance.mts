import assert from 'node:assert/strict';
import fs from 'node:fs/promises';
import path from 'node:path';
import { createHash } from 'node:crypto';
import mysql from 'mysql2/promise';
import { startTolanHrMysql, osEnvironmentKeys } from '../tolanhr-pilot-mysql.mjs';
import type { CaptureSourceEvent, SourceEventRecord } from '../../server/attendance-source-inbox/types';
import type { AttendanceSourceExecution } from '../../server/attendance-logic';

// This process uses only credentials generated by its own loopback MySQL helper.
const allowedEnvironment = new Set(osEnvironmentKeys.map(key => key.toLowerCase()));
for (const key of Object.keys(process.env)) if (!allowedEnvironment.has(key.toLowerCase())) delete process.env[key];
process.env.NODE_ENV = 'test';
process.env.TZ = 'Asia/Riyadh';

const streamId = '123e4567-e89b-42d3-a456-426614174098';
const activationUtc = '2026-11-25T00:00:00.000000Z';
const checks: string[] = [];
const cleanup: Record<string, unknown> = {};
let stage = 'start-owned-source-promotion-mysql';
let failure: { stage: string; code: string; line?: number } | undefined;
let lab: Awaited<ReturnType<typeof startTolanHrMysql>> | undefined;
let fixture: mysql.Connection | undefined;
let pool: mysql.Pool | undefined;
let financeFailure = false;
let workflowFailure = false;
let financeCalls = 0;
let uncommittedFinanceReads = 0;
const originalConsole = { log: console.log, warn: console.warn, error: console.error };
console.log = console.warn = console.error = () => {};

try {
  lab = await startTolanHrMysql();
  fixture = await lab.connect();
  const [[identity]] = await fixture.query<any[]>('SELECT DATABASE() AS db, @@port AS port, @@datadir AS datadir');
  assert.equal(identity.db, lab.schema);
  assert.equal(Number(identity.port), lab.port);
  assert.equal(path.resolve(identity.datadir), path.resolve(lab.data));
  assert.match(lab.schema, /^tolanhr_pilot_test_[a-f0-9]{12}$/);
  const url = new URL(lab.databaseUrl);
  assert.equal(url.hostname, '127.0.0.1');
  assert.equal(Number(url.port), lab.port);
  assert.equal(url.pathname, `/${lab.schema}`);
  pool = mysql.createPool({ host: '127.0.0.1', port: lab.port, database: lab.schema,
    user: decodeURIComponent(url.username), password: decodeURIComponent(url.password),
    dateStrings: true, supportBigNumbers: true, bigNumberStrings: true, timezone: 'Z',
    connectionLimit: 6, multipleStatements: false, flags: '-LOCAL_FILES' });
  checks.push('Fresh owned schema, random loopback port and datadir verified; no env file, app startup or live connection');

  stage = 'install-reviewed-ddl-on-owned-schema-only';
  await installCreate('../../docs/sql/attendance-source-events-2026-11-19/02-create.sql', 'test', 'attendance_source_events');
  await installCreate('../../docs/sql/attendance-biometric-import-progress-2026-11-19.sql', 'test', 'attendance_biometric_import_progress');
  await installCreate('../../docs/sql/attendance-biometric-directory-2026-11-19.test.sql', 'test', 'attendance_biometric_users');
  await installCreate('../../docs/sql/attendance-biometric-directory-2026-11-19.test.sql', 'test', 'attendance_biometric_worker_links');
  await installCreate('../../docs/sql/attendance-source-promotion-state-2026-11-25.TESTCOPY2.sql', 'TESTCOPY2', 'attendance_source_promotion_state');
  await fixture.execute(`INSERT INTO attendance_biometric_import_progress
    (id,stream_id,schema_version,tail_cursor,reconcile_cursor,updated_at)
    VALUES ('primary',?,1,'0','0',UTC_TIMESTAMP(6))`, [streamId]);
  for (let workerId = 1; workerId <= 20; workerId++) {
    await fixture.execute('INSERT INTO workers (id,code,full_name,status,daily_rate) VALUES (?,?,?,\'active\',120)',
      [workerId, `SYNTHETIC-PROMOTION-${workerId}`, `Synthetic promotion worker ${workerId}`]);
    await directoryUser(String(100 + workerId), String(workerId).padStart(5, '0'), 'current');
    await link(workerId, String(100 + workerId));
  }
  await directoryUser('700', '00010', 'historical');
  await fixture.execute("INSERT INTO attendance_events (id,worker_id,event_type,event_time,work_date,method) VALUES (1,1,'check_in','2026-11-19 13:00:00','2026-11-19','qr')");
  await fixture.execute("INSERT INTO worker_daily_finance (worker_id,work_date,worked_minutes,net_amount,notes) VALUES (1,'2026-11-19',60,25,'Synthetic preserved finance')");
  await fixture.execute("INSERT INTO settings (`key`,value,description) VALUES ('promotion_preserved_setting','unchanged','Synthetic preserved setting')");
  const historicalLedger = await oldLedger();
  checks.push('Only the five reviewed new CREATE definitions were retargeted; synthetic current identities and versioned links seeded independently of legacy person codes');

  const { createSourceAttendancePromotion } = await import('../../server/attendance-source-promotion/coordinator.ts');
  const { recordAttendanceWithAdministrativeDay } = await import('../../server/attendance-logic.ts');
  const { currentSourceAttendanceDatabase } = await import('../../server/db/source-execution-context.ts');
  const { getDb } = await import('../../server/db/connection.ts');
  const { processAttendanceToFinance } = await import('../../server/db/daily-finance.ts');
  const { attendanceEvents } = await import('../../drizzle/schema.ts');
  const { and, eq } = await import('drizzle-orm');
  const config = { database: lab.schema, streamId, intervalMs: 2000 as const, batchSize: 20 as const };
  const promotion = createSourceAttendancePromotion({ pool, config,
    async applyAttendance(event: SourceEventRecord, workerId: number, execution: AttendanceSourceExecution) {
      assert.equal(currentSourceAttendanceDatabase(), execution.database);
      assert.equal(await getDb(), execution.database);
      assert.equal(execution.deferFinance, true);
      assert.equal(execution.eventTime?.getTime(), new Date(event.eventTimeUtc).getTime());
      const saved = await recordAttendanceWithAdministrativeDay(workerId, event.source, undefined, undefined,
        undefined, 'Synthetic trusted source execution', event.eventType as 'check_in' | 'check_out', undefined, execution);
      if (workerId === 17 && workflowFailure) throw new Error('SYNTHETIC_POST_INSERT_FAILURE');
      return saved;
    },
    async processFinance(workerId: number, workDate: string) {
      financeCalls++;
      const database = await getDb();
      assert.ok(currentSourceAttendanceDatabase());
      assert.equal(database, currentSourceAttendanceDatabase());
      assert.ok(database);
      const inTransaction = await database.select({ id: attendanceEvents.id }).from(attendanceEvents)
        .where(and(eq(attendanceEvents.workerId, workerId), eq(attendanceEvents.eventType, 'check_out')));
      const [outside] = await fixture!.query<any[]>("SELECT id FROM attendance_events WHERE worker_id=? AND event_type='check_out'", [workerId]);
      assert.equal(inTransaction.length, outside.length + 1);
      uncommittedFinanceReads++;
      await processAttendanceToFinance(workerId, workDate);
      if (workerId === 5 && financeFailure) throw new Error('SYNTHETIC_FINANCE_FAILURE');
    },
    isPeriodLocked: async (_connection, _database, workerId) => workerId === 9,
  });
  const executeQr = (workerId: number, type: 'check_in' | 'check_out') => async (execution: AttendanceSourceExecution) => {
    assert.equal(await getDb(), execution.database);
    return recordAttendanceWithAdministrativeDay(workerId, 'qr', undefined, 1, undefined,
      'Synthetic QR source execution', type, undefined, execution);
  };

  stage = 'armed-without-manual-activation-is-archive-only';
  const beforeActivation = await promotion.captureBiometric(bio('pre-activation-recent', 14, 'check_in', '08:00:00'));
  const beforeActivationSnapshot = await raw(beforeActivation.event.id);
  assert.deepEqual(await promotion.runOnce(), { active: false, processed: 0 });
  assert.equal(await promotion.recordQr(qr('before-activation-qr', 14, 'check_in', '08:01:00'),
    async () => { throw new Error('UNEXPECTED_DISABLED_EXECUTION'); }), null);
  assert.equal((await attendance(14)).length, 0);
  await fixture.execute(`INSERT INTO attendance_source_promotion_state
    (id,stream_id,started_at_utc,activated_by) VALUES ('primary',?,?,NULL)`, [streamId, sql(activationUtc)]);
  await promotion.runOnce();
  assert.deepEqual(await raw(beforeActivation.event.id), beforeActivationSnapshot);
  assert.equal((await attendance(14)).length, 0);
  checks.push('An armed but empty activation table remains archive-only; pre-activation receipts stay untouched even when their event/received times are after the fixture cutoff');

  stage = 'both-cutoffs-and-exact-boundary';
  const priorEvent = await promotion.captureBiometric({ ...bio('prior-event-time', 12, 'check_in', '08:00:00'),
    eventTimeUtc: '2026-11-24T23:59:59.999999Z' });
  const priorReceipt = await promotion.captureBiometric(bio('prior-received-time', 13, 'check_in', '08:00:00'));
  await fixture.execute('UPDATE attendance_source_events SET received_at=? WHERE id=?',
    ['2026-11-24 23:59:59.999999', priorReceipt.event.id]);
  const priorSnapshots = [await raw(priorEvent.event.id), await raw(priorReceipt.event.id)];
  const boundary = await promotion.captureBiometric({ ...bio('exact-cutoff', 18, 'check_in', '00:00:00'), eventTimeUtc: activationUtc });
  await promotion.runOnce();
  assert.deepEqual([await raw(priorEvent.event.id), await raw(priorReceipt.event.id)], priorSnapshots);
  assert.equal((await attendance(12)).length, 0);
  assert.equal((await attendance(13)).length, 0);
  assert.equal((await raw(boundary.event.id)).status, 'accepted');
  assert.equal((await attendance(18))[0].work_date, '2026-11-24');
  assert.equal((await attendance(18))[0].event_time, '2026-11-25 03:00:00');
  checks.push('Both original event time and database receipt time must meet the fixed cutoff; the inclusive boundary uses the existing Riyadh administrative day');

  stage = 'identity-is-exact-and-pin-reuse-does-not-bind-history';
  const oldPin = await promotion.captureBiometric({ ...bio('old-pin-identity', 10, 'check_in', '08:00:00'), sourceIdentityId: '700' });
  const newPin = await promotion.captureBiometric(bio('current-pin-identity', 10, 'check_in', '08:00:01'));
  await promotion.runOnce();
  assert.equal((await raw(oldPin.event.id)).status, 'unmapped');
  assert.equal((await raw(oldPin.event.id)).attendance_event_id, null);
  assert.equal((await raw(newPin.event.id)).status, 'accepted');
  assert.equal((await attendance(10)).length, 1);
  const nullIdentity = await promotion.captureBiometric({ ...bio('missing-identity', 11, 'check_in', '08:00:00'), sourceIdentityId: null });
  const wrongDevice = await promotion.captureBiometric({ ...bio('wrong-device', 11, 'check_in', '08:00:01'), sourceDeviceId: '9002' });
  await promotion.runOnce();
  assert.equal((await raw(nullIdentity.event.id)).attendance_event_id, null);
  assert.equal((await raw(wrongDevice.event.id)).attendance_event_id, null);
  assert.equal((await attendance(11)).length, 0);
  checks.push('Only an exact stream, registration identity, device and PIN link resolves a worker; a reused PIN, missing identity or different device cannot borrow the current registration');

  stage = 'biometric-arrival-before-qr-drains-in-original-order';
  const bioFirst = await promotion.captureBiometric(bio('bio-first', 1, 'check_in', '08:00:00'));
  const immutableBefore = immutable(await raw(bioFirst.event.id));
  const confirmedBio = await promotion.recordQr(qr('qr-after-bio', 1, 'check_in', '08:10:00'), executeQr(1, 'check_in'));
  assert.equal((await attendance(1)).filter(row => row.work_date === '2026-11-25').length, 1);
  const acceptedBio = await raw(bioFirst.event.id);
  assert.equal(acceptedBio.status, 'accepted');
  assert.equal(acceptedBio.worker_id, null);
  assert.deepEqual(immutable(acceptedBio), immutableBefore);
  const bioFirstAttendance = (await attendance(1)).find(row => row.work_date === '2026-11-25');
  assert.equal(bioFirstAttendance.method, 'biometric');
  assert.equal(bioFirstAttendance.event_time, '2026-11-25 11:00:00');
  assert.equal(confirmedBio?.alreadyRecorded, true);
  assert.equal(confirmedBio?.source, 'biometric');
  assert.equal(confirmedBio?.eventId, bioFirstAttendance.id);
  assert.equal(confirmedBio?.timestamp.toISOString(), '2026-11-25T08:00:00.000Z');
  assert.equal(confirmedBio?.workDate, '2026-11-25');
  const rejectedQr = await receipt('qr', 'qr-after-bio');
  assert.equal(rejectedQr.decision_code, 'SOURCE_FIRST_ARRIVAL');
  assert.equal(JSON.parse(acceptedBio.decision_note).w, 1);
  assert.ok(JSON.parse(acceptedBio.decision_note).l);
  checks.push('A committed biometric receipt is drained before later QR; QR confirms the exact existing winner and original timestamp while its rejected source receipt, immutable raw payload and one attendance row remain intact');

  stage = 'qr-arrival-first-and-accepted-replay';
  const firstQr = await promotion.recordQr(qr('qr-first', 2, 'check_in', '08:00:00'), executeQr(2, 'check_in'));
  assert.ok(firstQr);
  const laterBio = await promotion.captureBiometric(bio('bio-after-qr', 2, 'check_in', '08:10:00'));
  await promotion.runOnce();
  assert.equal((await raw(laterBio.event.id)).decision_code, 'SOURCE_FIRST_ARRIVAL');
  assert.equal((await attendance(2)).length, 1);
  assert.equal((await attendance(2))[0].method, 'qr');
  const firstQrReceipt = await receipt('qr', 'qr-first');
  const repeatQr = await promotion.resumeQr(2, firstQrReceipt.id, async () => { throw new Error('UNEXPECTED_REPLAY_EXECUTION'); });
  assert.equal(repeatQr?.eventId, firstQr.eventId);
  assert.equal((await attendance(2)).length, 1);
  checks.push('QR wins when received first, including outside the old three-minute window; accepted QR receipt replay returns its original attendance ID without executing the workflow again');

  stage = 'auxiliary-four-states-remain-archive-only';
  const auxiliary: string[] = [];
  for (const [index, eventType] of ['break_out', 'break_in', 'overtime_in', 'overtime_out'].entries()) {
    const captured = await promotion.captureBiometric({ ...bio(`auxiliary-${index}`, 15, 'check_in', `08:0${index}:00`), eventType, rawState: String(index + 2) });
    auxiliary.push(captured.event.id);
  }
  await promotion.runOnce();
  for (const id of auxiliary) {
    const event = await raw(id);
    assert.equal(event.status, 'review_only');
    assert.equal(event.attendance_event_id, null);
  }
  assert.equal((await attendance(15)).length, 0);
  checks.push('All four auxiliary movement states remain archived and never invoke attendance or finance');

  stage = 'existing-same-source-cooldown-and-multiple-cycles';
  for (const [key, type, time] of [
    ['cycle-1-in', 'check_in', '08:00:00'], ['cycle-repeat-in', 'check_in', '08:03:01'],
    ['cycle-1-out', 'check_out', '08:06:02'], ['cycle-2-in', 'check_in', '08:10:00'], ['cycle-2-out', 'check_out', '08:20:00'],
  ] as const) {
    await promotion.captureBiometric(bio(key, 3, type, time));
    await promotion.runOnce();
  }
  assert.equal((await attendance(3)).length, 5);
  const cooled = await promotion.captureBiometric(bio('cycle-cooldown', 3, 'check_in', '08:20:30'));
  await promotion.runOnce();
  assert.equal((await raw(cooled.event.id)).decision_code, 'QR_COOLDOWN');
  assert.equal((await attendance(3)).length, 5);
  await promotion.captureBiometric(bio('phase-open-in', 20, 'check_in', '08:00:00'));
  await promotion.runOnce();
  const confirmedPhase = await promotion.recordQr(qr('phase-duplicate-in', 20, 'check_in', '08:10:00'), executeQr(20, 'check_in'));
  assert.equal(confirmedPhase?.alreadyRecorded, true);
  await promotion.recordQr(qr('phase-out', 20, 'check_out', '08:15:00'), executeQr(20, 'check_out'));
  await promotion.captureBiometric(bio('phase-next-in', 20, 'check_in', '08:20:00'));
  await promotion.runOnce();
  assert.deepEqual((await attendance(20)).map(row => row.event_type), ['check_in', 'check_out', 'check_in']);
  checks.push('The original any-type 180-second cooldown and same-source repeats after it are preserved; multiple cycles work and an opposite movement permits the next source phase');

  stage = 'real-finance-shares-uncommitted-attendance-transaction';
  for (const [key, type, time] of [
    ['finance-in', 'check_in', '08:00:00'], ['finance-out', 'check_out', '10:00:00'],
    ['finance-in-again', 'check_in', '10:05:00'], ['finance-out-again', 'check_out', '11:00:00'],
  ] as const) {
    await promotion.captureBiometric(bio(key, 4, type, time));
    await promotion.runOnce();
  }
  const [realFinance] = await fixture.query<any[]>("SELECT worked_minutes,check_in_time,check_out_time FROM worker_daily_finance WHERE worker_id=4 AND work_date='2026-11-25'");
  assert.equal(realFinance.length, 1);
  assert.equal(Number(realFinance[0].worked_minutes), 175);
  assert.equal(realFinance[0].check_in_time, '2026-11-25 11:00:00');
  assert.equal(realFinance[0].check_out_time, '2026-11-25 14:00:00');
  assert.ok(uncommittedFinanceReads >= 2);
  checks.push('Real finance helpers see the uncommitted checkout through the same AsyncLocalStorage-bound transaction and retain the existing 175-minute two-cycle result and Riyadh storage codec');

  stage = 'mapping-revocation-worker-status-and-payroll-lock';
  await fixture.execute("UPDATE workers SET status='inactive' WHERE id=6");
  await fixture.execute("UPDATE attendance_biometric_worker_links SET status='revoked',revoked_by=1,revoked_at_utc=UTC_TIMESTAMP(6) WHERE worker_id=7");
  const inactive = await promotion.captureBiometric(bio('inactive-worker', 6, 'check_in', '08:00:00'));
  const revoked = await promotion.captureBiometric(bio('revoked-link', 7, 'check_in', '08:00:00'));
  const locked = await promotion.captureBiometric(bio('locked-period', 9, 'check_in', '08:00:00'));
  await promotion.runOnce();
  assert.equal((await raw(inactive.event.id)).decision_code, 'SOURCE_WORKER_INACTIVE');
  assert.equal((await raw(revoked.event.id)).status, 'unmapped');
  assert.equal((await raw(locked.event.id)).decision_code, 'SOURCE_PERIOD_LOCKED');
  for (const id of [6, 7, 9]) assert.equal((await attendance(id)).length, 0);
  checks.push('Inactive workers and locked periods receive review outcomes; a revoked exact identity link remains unmapped and none creates attendance');

  stage = 'future-device-time-does-not-poison-valid-qr';
  const [[clock]] = await fixture.query<any[]>("SELECT DATE_FORMAT(DATE_ADD(UTC_TIMESTAMP(6),INTERVAL 2 DAY),'%Y-%m-%dT%H:%i:%s.%fZ') AS far_future");
  const future = await promotion.captureBiometric({ ...bio('far-future-device', 16, 'check_in', '08:00:00'), eventTimeUtc: clock.far_future });
  const futureIdentity = immutable(await raw(future.event.id));
  await promotion.runOnce();
  assert.equal((await raw(future.event.id)).decision_code, 'SOURCE_TIME_FUTURE');
  assert.deepEqual(immutable(await raw(future.event.id)), futureIdentity);
  assert.equal((await attendance(16)).length, 0);
  await promotion.recordQr(qr('valid-after-future-device', 16, 'check_in', '08:00:00'), executeQr(16, 'check_in'));
  assert.equal((await attendance(16)).length, 1);
  assert.equal((await attendance(16))[0].method, 'qr');
  checks.push('A future device clock is retained for review without attendance or raw-time correction, and a subsequent valid QR is admitted normally');

  stage = 'new-table-schema-tampering-fails-before-any-admission';
  for (const [index, table, errorCode] of [
    [0, 'attendance_source_events', 'INBOX_SCHEMA_NOT_READY'],
    [1, 'attendance_biometric_users', 'BIOMETRIC_DIRECTORY_SCHEMA_NOT_READY'],
  ] as const) {
    const captured = await promotion.captureBiometric(bio(`schema-guard-${index}`, 19, 'check_in', index ? '08:05:00' : '08:00:00'));
    const ledgerBefore = await workerLedger(19);
    const sourceBefore = await raw(captured.event.id);
    await fixture.query(`ALTER TABLE \`${table}\` ADD INDEX owned_unexpected_index (\`${table === 'attendance_source_events' ? 'event_type' : 'device_user_id'}\`)`);
    try {
      const guarded = createSourceAttendancePromotion({ pool, config });
      await rejects(() => guarded.runOnce(), errorCode);
      assert.deepEqual(await workerLedger(19), ledgerBefore);
      assert.deepEqual(await raw(captured.event.id), sourceBefore);
    } finally {
      await fixture.query(`ALTER TABLE \`${table}\` DROP INDEX owned_unexpected_index`);
    }
    await promotion.runOnce();
    assert.equal((await raw(captured.event.id)).status, 'accepted');
  }
  checks.push('A fresh coordinator rejects an extra index on either the inbox or directory table before attendance, finance, worker or pending-receipt mutation');

  stage = 'post-commit-qr-verification-failure-is-safe-to-resume';
  const unavailablePool = new Proxy(pool, { get(target, property) {
    if (property === 'execute') return async (statement: string, ...parameters: any[]) => {
      if (statement.startsWith('SELECT worker_id,event_type,DATE_FORMAT(work_date,')) throw new Error('SYNTHETIC_QR_RESULT_READ_FAILURE');
      return (target.execute as any)(statement, ...parameters);
    };
    const value = Reflect.get(target, property);
    return typeof value === 'function' ? value.bind(target) : value;
  } });
  const unavailable = createSourceAttendancePromotion({ pool: unavailablePool, config });
  await rejects(() => unavailable.recordQr(qr('committed-qr-result-unavailable', 19, 'check_out', '08:10:00'), executeQr(19, 'check_out')), 'CONFLICT');
  const committedQr = await receipt('qr', 'committed-qr-result-unavailable');
  assert.equal(committedQr.status, 'accepted');
  assert.ok(committedQr.attendance_event_id);
  assert.equal((await attendance(19)).length, 3);
  const afterVerificationFailure = await workerLedger(19);
  const recoveredQr = await promotion.resumeQr(19, committedQr.id, async () => { throw new Error('UNEXPECTED_COMMITTED_QR_REEXECUTION'); });
  assert.equal(recoveredQr?.eventId, committedQr.attendance_event_id);
  assert.deepEqual(await workerLedger(19), afterVerificationFailure);
  checks.push('A post-commit QR result-query failure becomes a safe conflict while the accepted receipt/attendance remain durable; resuming returns the same result without repeating finance or attendance');

  stage = 'concurrent-qr-and-biometric-arrivals-share-the-gate';
  const concurrent = await Promise.allSettled([
    promotion.captureBiometric(bio('concurrent-bio', 8, 'check_in', '08:00:00')),
    promotion.recordQr(qr('concurrent-qr', 8, 'check_in', '08:00:01'), executeQr(8, 'check_in')),
  ]);
  assert.ok(concurrent.some(value => value.status === 'fulfilled'));
  for (const result of concurrent) if (result.status === 'rejected') assert.equal(result.reason?.code, 'BAD_REQUEST');
  await promotion.runOnce();
  const simultaneousRows = await attendance(8);
  assert.equal(simultaneousRows.length, 1);
  const concurrentBio = await receipt('biometric', 'concurrent-bio');
  const concurrentQr = await receipt('qr', 'concurrent-qr');
  assert.equal([concurrentBio, concurrentQr].filter(row => row.status === 'accepted').length, 1);
  const concurrentRejected = [concurrentBio, concurrentQr].filter(row => row.status === 'rejected');
  assert.equal(concurrentRejected.length, 1);
  assert.ok(['SOURCE_FIRST_ARRIVAL', 'QR_COOLDOWN'].includes(concurrentRejected[0].decision_code));
  checks.push('Concurrent biometric ingress and QR admission serialize on the database activation gate and produce exactly one accepted movement');

  stage = 'source-replay-preserves-hash-and-outcome';
  const beforeReplay = await raw(bioFirst.event.id);
  const replayed = await promotion.captureBiometric(bio('bio-first', 1, 'check_in', '08:00:00'));
  assert.equal(replayed.replayed, true);
  assert.equal(replayed.event.id, bioFirst.event.id);
  await promotion.runOnce();
  assert.deepEqual(await raw(bioFirst.event.id), beforeReplay);
  await rejects(() => promotion.captureBiometric(bio('bio-first', 1, 'check_in', '08:00:01')), 'SOURCE_PROMOTION_CONTENT_CONFLICT');
  assert.deepEqual(await raw(bioFirst.event.id), beforeReplay);
  checks.push('Technical source replay is idempotent, changed payload conflicts, and promotion never rewrites the original hash or worker/device identity payload');

  stage = 'duplicate-qr-replay-keeps-frozen-winner-after-new-phase-and-rebinding';
  await promotion.captureBiometric(bio('winner-later-checkout', 1, 'check_out', '08:20:00'));
  await promotion.runOnce();
  await fixture.execute("UPDATE attendance_biometric_worker_links SET status='revoked',revoked_by=1,revoked_at_utc=UTC_TIMESTAMP(6) WHERE worker_id=1");
  await fixture.execute(`INSERT INTO attendance_biometric_worker_links
    (id,stream_id,source_identity_id,worker_id,status,device_id_snapshot,device_user_id_snapshot,
     display_name_snapshot,device_name_snapshot,serial_number_snapshot,worker_name_snapshot,created_by,created_at_utc)
    VALUES ('00000000-0000-4000-8000-000000000099',?,'101',11,'active','9001','00001',
     'Synthetic reassigned identity','Synthetic SpeedFace','SYNTHETIC-DEVICE','Synthetic other worker',1,UTC_TIMESTAMP(6))`, [streamId]);
  const afterRebinding = await workerLedger(1);
  const unchangedRejected = await raw(rejectedQr.id);
  const replayedConfirmation = await promotion.resumeQr(1, rejectedQr.id, async () => { throw new Error('UNEXPECTED_DUPLICATE_WORKFLOW'); });
  assert.deepEqual(replayedConfirmation, confirmedBio);
  assert.deepEqual(await workerLedger(1), afterRebinding);
  assert.deepEqual(await raw(rejectedQr.id), unchangedRejected);
  await fixture.execute('UPDATE attendance_events SET worker_id=11 WHERE id=?', [confirmedBio!.eventId]);
  try {
    await rejects(() => promotion.resumeQr(1, rejectedQr.id, executeQr(1, 'check_in')), 'CONFLICT');
  } finally { await fixture.execute('UPDATE attendance_events SET worker_id=1 WHERE id=?', [confirmedBio!.eventId]); }
  assert.deepEqual(await workerLedger(1), afterRebinding);
  await fixture.execute('UPDATE attendance_biometric_worker_links SET device_user_id_snapshot=? WHERE id=?', ['OWNED-WRONG-PIN', linkId(1)]);
  try {
    await rejects(() => promotion.resumeQr(1, rejectedQr.id, executeQr(1, 'check_in')), 'CONFLICT');
  } finally {
    await fixture.execute('UPDATE attendance_biometric_worker_links SET device_user_id_snapshot=? WHERE id=?', ['00001', linkId(1)]);
  }
  checks.push('The same rejected QR attempt keeps confirming its frozen original winner after a later checkout and identity rebind; a mismatched winning attendance fails safely without writes');

  stage = 'post-insert-workflow-failure-rolls-back';
  const failingWorkflow = await promotion.captureBiometric(bio('workflow-failure', 17, 'check_in', '08:00:00'));
  const beforeWorkflow = await workerLedger(17);
  const failingRaw = await raw(failingWorkflow.event.id);
  workflowFailure = true;
  await rejects(() => promotion.runOnce(), 'SYNTHETIC_POST_INSERT_FAILURE');
  assert.deepEqual(await workerLedger(17), beforeWorkflow);
  assert.deepEqual(await raw(failingWorkflow.event.id), failingRaw);
  workflowFailure = false;
  await promotion.runOnce();
  assert.equal((await attendance(17)).length, 1);
  checks.push('An unexpected failure after the actual attendance INSERT rolls back attendance, last-attendance update and outcome; retry later inserts once');

  stage = 'finance-failure-rolls-back-attendance-finance-and-evidence';
  await promotion.captureBiometric(bio('rollback-in', 5, 'check_in', '08:00:00'));
  await promotion.runOnce();
  const failingFinance = await promotion.captureBiometric(bio('rollback-out', 5, 'check_out', '10:00:00'));
  const beforeFinance = await workerLedger(5);
  const financeRaw = await raw(failingFinance.event.id);
  financeFailure = true;
  await rejects(() => promotion.runOnce(), 'SYNTHETIC_FINANCE_FAILURE');
  assert.deepEqual(await workerLedger(5), beforeFinance);
  assert.deepEqual(await raw(failingFinance.event.id), financeRaw);
  financeFailure = false;
  await promotion.runOnce();
  assert.equal((await attendance(5)).length, 2);
  assert.equal((await raw(failingFinance.event.id)).status, 'accepted');
  const [recoveredFinance] = await fixture.query<any[]>('SELECT worked_minutes FROM worker_daily_finance WHERE worker_id=5');
  assert.equal(Number(recoveredFinance[0].worked_minutes), 120);
  await promotion.runOnce();
  assert.equal((await attendance(5)).length, 2);
  checks.push('Failure after real finance writes rolls back the entire admission, preserving its committed pending receipt; retry produces one checkout and one correct 120-minute finance result');

  stage = 'historical-ledger-and-fixed-activation-are-unchanged';
  assert.deepEqual(await oldLedger(), historicalLedger);
  assert.deepEqual(await raw(beforeActivation.event.id), beforeActivationSnapshot);
  assert.deepEqual([await raw(priorEvent.event.id), await raw(priorReceipt.event.id)], priorSnapshots);
  assert.deepEqual(await promotion.readActivation(), { streamId, startedAtUtc: activationUtc });
  assert.ok(financeCalls >= 5);
  checks.push('Historical attendance, finance, settings, old import records, pre-activation receipts and the durable activation timestamp remain byte-for-byte unchanged');

  async function installCreate(relativeFile: string, expectedSchema: string, table: string) {
    assert.ok(lab && fixture);
    const qualified = `\`${expectedSchema}\`.\`${table}\``;
    const file = await fs.readFile(new URL(relativeFile, import.meta.url), 'utf8');
    const statements = file.split(/\r?\n/).filter(line => !line.trimStart().startsWith('--')).join('\n').split(';').map(value => value.trim());
    const create = statements.find(value => value.startsWith(`CREATE TABLE ${qualified} (`));
    assert.ok(create, 'REVIEWED_CREATE_NOT_FOUND');
    assert.equal(create.split(qualified).length, 2);
    await fixture.query(create.replace(qualified, `\`${lab.schema}\`.\`${table}\``));
  }

  async function directoryUser(identityId: string, pin: string, status: 'current' | 'historical') {
    await fixture!.execute(`INSERT INTO attendance_biometric_users
      (stream_id,source_identity_id,device_id,device_user_id,display_name,device_name,serial_number,status,last_synced_at_utc)
      VALUES (?,?, '9001', ?, 'Synthetic directory user', 'Synthetic SpeedFace', 'SYNTHETIC-DEVICE', ?,UTC_TIMESTAMP(6))`,
    [streamId, identityId, pin, status]);
  }

  async function link(workerId: number, identityId: string) {
    await fixture!.execute(`INSERT INTO attendance_biometric_worker_links
      (id,stream_id,source_identity_id,worker_id,status,device_id_snapshot,device_user_id_snapshot,
       display_name_snapshot,device_name_snapshot,serial_number_snapshot,worker_name_snapshot,created_by,created_at_utc)
      VALUES (?,?,?,?,'active','9001',?,'Synthetic directory user','Synthetic SpeedFace','SYNTHETIC-DEVICE','Synthetic worker',1,'2026-11-24 00:00:00')`,
    [linkId(workerId), streamId, identityId, workerId, String(workerId).padStart(5, '0')]);
  }

  async function raw(id: string) {
    const [rows] = await fixture!.query<any[]>('SELECT * FROM attendance_source_events WHERE id=?', [id]);
    assert.equal(rows.length, 1);
    return rows[0];
  }

  async function receipt(source: string, key: string) {
    const [rows] = await fixture!.query<any[]>('SELECT * FROM attendance_source_events WHERE source=? AND source_event_id=?', [source, source === 'biometric' ? biometricKey(key) : key]);
    assert.equal(rows.length, 1);
    return rows[0];
  }

  async function attendance(workerId: number) {
    const [rows] = await fixture!.query<any[]>('SELECT id,worker_id,event_type,event_time,work_date,method FROM attendance_events WHERE worker_id=? ORDER BY event_time,id', [workerId]);
    return rows;
  }

  async function workerLedger(workerId: number) {
    const [workers] = await fixture!.query('SELECT * FROM workers WHERE id=?', [workerId]);
    const [events] = await fixture!.query('SELECT * FROM attendance_events WHERE worker_id=? ORDER BY id', [workerId]);
    const [finance] = await fixture!.query('SELECT * FROM worker_daily_finance WHERE worker_id=? ORDER BY id', [workerId]);
    return { workers, events, finance };
  }

  async function oldLedger() {
    const [events] = await fixture!.query('SELECT * FROM attendance_events WHERE id=1');
    const [finance] = await fixture!.query("SELECT * FROM worker_daily_finance WHERE work_date='2026-11-19'");
    const [settings] = await fixture!.query('SELECT * FROM settings ORDER BY id');
    const [imports] = await fixture!.query('SELECT * FROM biometric_final_event_imports ORDER BY id');
    return { events, finance, settings, imports };
  }
} catch (error) {
  const candidate = (error as any)?.code ?? (error as any)?.message;
  const line = /acceptance\.mts:(\d+):\d+/.exec((error as any)?.stack ?? '')?.[1];
  failure = { stage, code: typeof candidate === 'string' && /^[A-Z][A-Z0-9_]{1,80}$/.test(candidate) ? candidate : 'SOURCE_PROMOTION_ACCEPTANCE_FAILED',
    ...(line ? { line: Number(line) } : {}) };
} finally {
  try { await pool?.end(); await fixture?.end(); cleanup.localConnectionsClosed = true; }
  catch { failure ??= { stage: 'close-owned-connections', code: 'SOURCE_PROMOTION_CLEANUP_FAILED' }; }
  try { if (lab) Object.assign(cleanup, await lab.close()); }
  catch { failure ??= { stage: 'stop-owned-mysql', code: 'SOURCE_PROMOTION_CLEANUP_FAILED' }; }
  console.log = originalConsole.log;
  console.warn = originalConsole.warn;
  console.error = originalConsole.error;
}

const report = { passed: !failure, completedAtUtc: new Date().toISOString(),
  fixture: 'Synthetic records in a process-owned random loopback MySQL schema; no env file or live database',
  checks, financeCalls, uncommittedFinanceReads, cleanup, ...(failure ? { failure } : {}) };
await fs.writeFile(path.join(import.meta.dirname, 'result.json'), JSON.stringify(report, null, 2) + '\n');
process.stdout.write(JSON.stringify(report) + '\n');
if (failure) process.exitCode = 1;

function bio(sourceEventId: string, workerId: number, eventType: 'check_in' | 'check_out', time: string): CaptureSourceEvent {
  return { source: 'biometric', sourceEventId: biometricKey(sourceEventId), eventType, rawState: eventType === 'check_in' ? '0' : '1',
    eventTimeUtc: `2026-11-25T${time}.000000Z`, workerId: null, sourcePersonCode: null, sourceUserName: null,
    sourceDeviceId: '9001', sourceDeviceUserId: String(workerId).padStart(5, '0'), sourceIdentityId: String(100 + workerId) };
}

function qr(sourceEventId: string, workerId: number, eventType: 'check_in' | 'check_out', time: string): CaptureSourceEvent {
  return { source: 'qr', sourceEventId, workerId, eventType, eventTimeUtc: `2026-11-25T${time}.000000Z` };
}

function sql(value: string) { return value.slice(0, -1).replace('T', ' '); }
function biometricKey(value: string) { return `bio:${createHash('sha256').update(JSON.stringify([streamId, value])).digest('hex')}`; }
function linkId(workerId: number) { return `00000000-0000-4000-8000-${String(workerId).padStart(12, '0')}`; }
function immutable(row: any) {
  return Object.fromEntries(['id', 'source', 'source_event_id', 'content_sha256', 'worker_id', 'source_person_code',
    'source_device_id', 'source_device_user_id', 'source_identity_id', 'source_user_name', 'event_type', 'raw_state',
    'event_time_utc', 'received_at'].map(key => [key, row[key]]));
}
async function rejects(operation: () => Promise<unknown>, code: string) {
  await assert.rejects(operation, (error: any) => error?.code === code || error?.message === code);
}
